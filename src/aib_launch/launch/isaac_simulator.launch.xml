<?xml version="1.0" encoding="UTF-8"?>
<!-- Autoware for an ego on Isaac Sim.

     The Autoware side of an aib ego: the Autoware profile for a simulated car
     (autoware_sim_profile, from autoware_sim_vehicle) with aib's vehicle and sensor kit, and no
     vehicle interface of its own: the Isaac side (aib's runner, or scenario-world-bridge's
     Isaac world server) publishes /vehicle/status/*, /clock and the sensors on this domain
     and takes /control/command/*.

       ROS_DOMAIN_ID=1 play_launch launch aib_launch isaac_simulator.launch.xml \
           map_path:=<map dir> [rviz:=false] [name:=value ...]

     Every other argument is the profile's and passes through (launch arguments are global):
     data_path, rviz, gpu, extra_launch, lidar_detection_model, perception, max_velocity...
     Needs autoware_sim_vehicle's packages: deps/autoware_sim_vehicle (just build builds it).
-->
<launch>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="aib_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="aib_sensor_kit" description="sensor model name"/>

  <include file="$(find-pkg-share autoware_sim_profile)/launch/autoware.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
  </include>
</launch>
