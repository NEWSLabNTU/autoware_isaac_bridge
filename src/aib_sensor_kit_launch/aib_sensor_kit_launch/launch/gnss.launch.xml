<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!--
    GNSS Processing - Converts NavSatFix from Isaac to PoseWithCovariance for Autoware.
    Flow: Isaac ego NavSatFix → gnss_poser → /sensing/gnss/pose_with_covariance → pose_initializer
    Requires map_projector_info.yaml with projector_type: TransverseMercator
  -->

  <arg name="gnss_fix_name" default="gnss_link/nav_sat_fix" description="NavSatFix topic, relative to /sensing/gnss"/>

  <group>
    <push-ros-namespace namespace="gnss"/>

    <!-- GNSS Poser: NavSatFix → PoseWithCovariance converter -->
    <node pkg="autoware_gnss_poser" exec="gnss_poser" name="gnss_poser" output="screen">
      <!-- Input topics -->
      <!-- The Isaac ego publishes to /sensing/gnss/gnss_link/nav_sat_fix (the spec's topic) -->
      <remap from="fix" to="$(var gnss_fix_name)"/>

      <!-- Output topics -->
      <remap from="gnss_pose" to="pose"/>
      <remap from="gnss_pose_cov" to="pose_with_covariance"/>
      <remap from="gnss_fixed" to="fixed"/>

      <!-- Load required parameters -->
      <param from="$(find-pkg-share autoware_gnss_poser)/config/gnss_poser.param.yaml"/>
      <!-- Disable orientation from IMU: Isaac IMU publishes sensor_msgs/Imu, not GnssInsOrientationStamped.
           Use position-derived orientation instead. -->
      <param name="use_gnss_ins_orientation" value="false"/>
    </node>
  </group>
</launch>
