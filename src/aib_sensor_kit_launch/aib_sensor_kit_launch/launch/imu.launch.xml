<launch>
  <!--
    IMU Processing Launch File

    The Isaac ego publishes IMU data to /sensing/imu/carla/imu_link/imu_raw
    (the spec's imu frame, carla/imu_link, kept from csb_isaac)

    Data Flow:
    ==========
    Isaac IMU (aib) → /sensing/imu/carla/imu_link/imu_raw
                      ↓
               imu_corrector
                      ↓
               /sensing/imu/imu_data
  -->

  <group>
    <push-ros-namespace namespace="imu"/>
    <include file="$(find-pkg-share autoware_imu_corrector)/launch/imu_corrector.launch.xml">
      <!-- The Isaac ego publishes to carla/imu_link/imu_raw (the spec's topic) -->
      <arg name="input_topic" value="carla/imu_link/imu_raw"/>
      <arg name="output_topic" value="imu_data"/>
    </include>

    <include file="$(find-pkg-share autoware_imu_corrector)/launch/gyro_bias_estimator.launch.xml">
      <arg name="input_imu_raw" value="carla/imu_link/imu_raw"/>
      <arg name="input_odom" value="/localization/kinematic_state"/>
    </include>
  </group>
</launch>
